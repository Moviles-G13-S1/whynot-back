{
  "name": "whynot-back",
  "version": "1.0.0",
  "private": true,
  "description": "Versioned Firebase backend for WhyNot mobile clients",
  "type": "module",
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "emulators": "firebase emulators:start --project demo-whynot",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-whynot \"mocha --timeout 15000 tests/firestore-rules/**/*.test.mjs\"",
    "seed:categories": "node scripts/seed-categories/index.mjs",
    "seed:analytics-demo": "node scripts/seed-analytics-demo/index.mjs",
    "reset:analytics-demo": "node scripts/reset-analytics-demo/index.mjs",
    "seed:cities": "node scripts/seed-cities/index.mjs",
    "assign-admin": "node scripts/assign-admin-role/index.mjs",
    "deploy:storage": "npm run test:rules && firebase deploy --only storage",
    "deploy:firestore": "npm run test:rules && firebase deploy --only firestore",
    "deploy:functions:nearby": "npm run test:smart-features && firebase deploy --only functions:get_nearest_store",
    "seed:stores": "node scripts/seed-stores/index.mjs",
    "test:smart-features": "firebase emulators:exec --only auth,firestore,functions --project demo-whynot \"node scripts/test-smart-features/index.mjs\"",
    "test:wishlist-delete": "firebase emulators:exec --only auth,firestore,functions --project demo-whynot \"node scripts/test-wishlist-delete/index.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.2",
    "mocha": "12.0.2"
  },
  "dependencies": {
    "firebase-admin": "14.4.0"
  }
}
