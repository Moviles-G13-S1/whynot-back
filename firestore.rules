rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validNonEmptyString(value, maximumLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maximumLength;
    }

    function validString(value, maximumLength) {
      return value is string && value.size() <= maximumLength;
    }

    function categoryExists(categoryId) {
      return categoryId is string
        && exists(/databases/$(database)/documents/categories/$(categoryId));
    }

    function cityExists(cityId) {
      return cityId is string
        && exists(/databases/$(database)/documents/cities/$(cityId));
    }

    // Santiago Casasbuenas: Validate private photo paths alongside profile fields.
    function validUser(data, uid) {
      return data.keys().hasAll([
          'name',
          'email',
          'gender',
          'age',
          'preferredCategoryId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'email',
          'gender',
          'age',
          'preferredCategoryId',
          'cityId',
          'photoPath',
          'createdAt',
          'updatedAt'
        ])
        && validNonEmptyString(data.name, 120)
        && validNonEmptyString(data.email, 320)
        && data.gender in ['Female', 'Male', 'Other']
        && data.age is int
        && data.age >= 13
        && data.age <= 120
        && categoryExists(data.preferredCategoryId)
        && (!data.keys().hasAny(['cityId']) || cityExists(data.cityId))
        && (!data.keys().hasAny(['photoPath'])
          || (data.photoPath is string
            && data.photoPath.matches('^profilePhotos/' + uid + '/[0-9]+-[0-9]+\\.(jpg|png)$')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validWishlist(data) {
      return data.keys().hasAll([
          'ownerId',
          'categoryId',
          'imageUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'categoryId',
          'imageUrl',
          'emoji',
          'deleting',
          'deleteOperationId',
          'deleteReservedAt',
          'createdAt',
          'updatedAt'
        ])
        && validNonEmptyString(data.ownerId, 128)
        && categoryExists(data.categoryId)
        && validString(data.imageUrl, 2048)
        && (!data.keys().hasAny(['emoji'])
          || data.emoji in ['🎁', '✨', '❤️', '🛍️', '👗', '🎮', '🏠', '✈️'])
        && (!data.keys().hasAny(['deleting']) || data.deleting is bool)
        && (!data.keys().hasAny(['deleteOperationId']) || validNonEmptyString(data.deleteOperationId, 128))
        && (!data.keys().hasAny(['deleteReservedAt']) || data.deleteReservedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function wishlistExists(wishlistId) {
      return wishlistId is string
        && exists(/databases/$(database)/documents/wishlists/$(wishlistId));
    }

    function wishlistBelongsToCurrentUser(wishlistId) {
      return signedIn()
        && wishlistExists(wishlistId)
        && get(
          /databases/$(database)/documents/wishlists/$(wishlistId)
        ).data.ownerId == currentUid();
    }

    function validProductWishlist(data) {
      return wishlistBelongsToCurrentUser(data.wishlistId)
        && get(/databases/$(database)/documents/wishlists/$(data.wishlistId)).data.get('deleting', false) == false
        && get(
          /databases/$(database)/documents/wishlists/$(data.wishlistId)
        ).data.categoryId == data.categoryId;
    }

    function validProduct(data) {
      return data.keys().hasAll([
          'ownerId',
          'wishlistId',
          'categoryId',
          'name',
          'brand',
          'price',
          'imageUrl',
          'productUrl',
          'purchased',
          'purchasedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'wishlistId',
          'categoryId',
          'name',
          'brand',
          'price',
          'imageUrl',
          'productUrl',
          'purchased',
          'purchasedAt',
          'createdAt',
          'updatedAt'
        ])
        && validNonEmptyString(data.ownerId, 128)
        && validNonEmptyString(data.wishlistId, 1500)
        && validNonEmptyString(data.categoryId, 1500)
        && validNonEmptyString(data.name, 200)
        && validNonEmptyString(data.brand, 200)
        && data.price is number
        && data.price >= 0
        && validString(data.imageUrl, 2048)
        && validString(data.productUrl, 2048)
        && data.purchased is bool
        && (
          (!data.purchased && data.purchasedAt == null)
          || (data.purchased && data.purchasedAt is timestamp)
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validProductWishlist(data);
    }

    // One product-save attempt from a mobile client (BQ Type 2). Success has
    // no reason; a failure carries a short machine-readable reason code.
    function validProductSaveEvent(data) {
      return data.keys().hasAll([
          'userId',
          'platform',
          'outcome',
          'reason',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'platform',
          'outcome',
          'reason',
          'createdAt'
        ])
        && data.userId == currentUid()
        && data.platform in ['android', 'ios', 'web']
        && (
          (data.outcome == 'success' && data.reason == null)
          || (data.outcome == 'failure' && validNonEmptyString(data.reason, 64))
        )
        && data.createdAt == request.time;
    }

    function validOnboardingEvent(eventId, data) {
      return data.keys().hasAll([
          'userId',
          'platform',
          'step',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'platform',
          'step',
          'createdAt'
        ])
        && data.userId == currentUid()
        && data.platform in ['android', 'ios']
        && data.step in ['sign_up_completed', 'first_wishlist_created']
        && eventId == currentUid() + '_' + data.step
        && data.createdAt == request.time;
    }

    match /users/{uid} {
      allow get: if signedIn() && currentUid() == uid;
      allow list: if isAdmin();

      allow create: if signedIn()
        && currentUid() == uid
        && validUser(request.resource.data, uid)
        && request.resource.data.keys().hasAll(['cityId'])
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && currentUid() == uid
        && validUser(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'gender',
          'age',
          'preferredCategoryId',
          'cityId',
          'photoPath',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if false;
    }

    match /wishlists/{wishlistId} {
      allow get: if signedIn() && resource.data.ownerId == currentUid();
      allow list: if signedIn() && resource.data.ownerId == currentUid();

      allow create: if signedIn()
        && validWishlist(request.resource.data)
        && !request.resource.data.keys().hasAny(['deleting', 'deleteOperationId', 'deleteReservedAt'])
        && request.resource.data.ownerId == currentUid()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.ownerId == currentUid()
        && resource.data.get('deleting', false) == false
        && validWishlist(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrl', 'emoji', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      // Deletion is handled by a callable transaction that checks products.
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if signedIn()
        && (
          resource.data.ownerId == currentUid()
          || wishlistBelongsToCurrentUser(resource.data.wishlistId)
        );

      allow list: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.ownerId == currentUid()
          || wishlistBelongsToCurrentUser(resource.data.wishlistId)
        );

      allow create: if signedIn()
        && validProduct(request.resource.data)
        && request.resource.data.ownerId == currentUid()
        && request.resource.data.purchased == false
        && request.resource.data.purchasedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.ownerId == currentUid()
        && request.resource.data.ownerId == currentUid()
        && validProduct(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'wishlistId',
          'categoryId',
          'name',
          'brand',
          'price',
          'imageUrl',
          'productUrl',
          'purchased',
          'purchasedAt',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.purchased == resource.data.purchased
            && request.resource.data.purchasedAt == resource.data.purchasedAt
          )
          || (
            resource.data.purchased == false
            && resource.data.purchasedAt == null
            && request.resource.data.purchased == true
            && request.resource.data.purchasedAt == request.time
          )
        );

      allow delete: if signedIn() && resource.data.ownerId == currentUid();
    }

    match /uxEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId', 'eventName', 'source', 'platform', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'eventName', 'source', 'platform', 'createdAt'])
        && request.resource.data.userId == currentUid()
        && request.resource.data.platform == 'android'
        && request.resource.data.eventName in ['home_empty_state_viewed', 'home_empty_state_clicked', 'add_product_navigation']
        && request.resource.data.source in ['home_empty_state', 'home_bottom_bar']
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Sprint 3 BQ (money saved): what a user paid when marking one of their
    // products as purchased, next to the price they had saved. The event is
    // stored under the product id, so a purchase cannot be counted twice, and
    // the saved price and category must match the purchased product itself.
    function validPurchaseEvent(productId, data) {
      let productPath = /databases/$(database)/documents/products/$(productId);
      return data.keys().hasAll([
          'userId',
          'productId',
          'categoryId',
          'referencePrice',
          'purchasePrice',
          'platform',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'productId',
          'categoryId',
          'referencePrice',
          'purchasePrice',
          'platform',
          'createdAt'
        ])
        && data.userId == currentUid()
        && data.productId == productId
        && data.referencePrice is number
        && data.referencePrice >= 0
        && data.purchasePrice is number
        && data.purchasePrice >= 0
        && data.platform in ['android', 'ios']
        && data.createdAt == request.time
        && exists(productPath)
        && get(productPath).data.ownerId == currentUid()
        && get(productPath).data.purchased == true
        && get(productPath).data.categoryId == data.categoryId
        && get(productPath).data.price == data.referencePrice;
    }

    match /productPurchaseEvents/{productId} {
      allow create: if signedIn() && validPurchaseEvent(productId, request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /productSaveEvents/{eventId} {
      allow create: if signedIn() && validProductSaveEvent(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /wishlistInteractionEvents/{eventId} {
      allow create: if signedIn()
        && eventId == request.resource.data.operationId
        && request.resource.data.keys().hasAll(['action', 'outcome', 'reason', 'userId', 'platform', 'operationId', 'schemaVersion', 'createdAt'])
        && request.resource.data.keys().hasOnly(['action', 'outcome', 'reason', 'userId', 'wishlistId', 'categoryId', 'platform', 'operationId', 'schemaVersion', 'createdAt'])
        && request.resource.data.userId == currentUid()
        && request.resource.data.action in ['create_form_open', 'create_form_cancel', 'create', 'open', 'edit']
        && (
          (request.resource.data.action in ['create_form_open', 'create_form_cancel', 'open']
            && request.resource.data.outcome == 'intent'
            && request.resource.data.reason == 'none')
          || (request.resource.data.action in ['create', 'edit']
            && request.resource.data.outcome in ['success', 'failure']
            && ((request.resource.data.outcome == 'success' && request.resource.data.reason == 'none')
              || (request.resource.data.outcome == 'failure' && request.resource.data.reason in ['validation', 'network', 'permission', 'unknown', 'not_found'])))
        )
        && request.resource.data.reason in ['none', 'validation', 'network', 'permission', 'unknown', 'nonempty', 'not_found']
        && request.resource.data.platform in ['android', 'ios', 'web']
        && request.resource.data.schemaVersion == 1
        && validNonEmptyString(request.resource.data.operationId, 128)
        && (!request.resource.data.keys().hasAny(['wishlistId']) || validNonEmptyString(request.resource.data.wishlistId, 128))
        && (!request.resource.data.keys().hasAny(['categoryId']) || validNonEmptyString(request.resource.data.categoryId, 128))
        && (request.resource.data.outcome != 'success' || (
          request.resource.data.keys().hasAny(['wishlistId'])
          && existsAfter(/databases/$(database)/documents/wishlists/$(request.resource.data.wishlistId))
          && getAfter(/databases/$(database)/documents/wishlists/$(request.resource.data.wishlistId)).data.ownerId == currentUid()
          && getAfter(/databases/$(database)/documents/wishlists/$(request.resource.data.wishlistId)).data.updatedAt == request.time
          && (request.resource.data.action != 'create'
            || !exists(/databases/$(database)/documents/wishlists/$(request.resource.data.wishlistId)))
        ))
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /onboardingEvents/{eventId} {
      allow create: if signedIn() && validOnboardingEvent(eventId, request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /adminMetrics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /productEvents/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /recommendationHomeEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId', 'platform', 'eventType', 'impressionId', 'recommendationEventId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'platform', 'eventType', 'impressionId', 'recommendationEventId', 'createdAt'])
        && request.resource.data.userId == currentUid()
        && request.resource.data.platform == 'flutter'
        && request.resource.data.eventType in ['card_displayed', 'detail_opened']
        && request.resource.data.impressionId is string
        && request.resource.data.impressionId.matches('^[0-9a-f]{32}$')
        && validNonEmptyString(request.resource.data.recommendationEventId, 128)
        && exists(/databases/$(database)/documents/productEvents/$(request.resource.data.recommendationEventId))
        && get(/databases/$(database)/documents/productEvents/$(request.resource.data.recommendationEventId)).data.userId == currentUid()
        && eventId == request.resource.data.impressionId + (request.resource.data.eventType == 'card_displayed' ? '_display' : '_open')
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /processedEvents/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
